PORT=4000

CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

# Postgres (docker-compose подставляет их в сервис db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_hub
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Prisma / Nest: строка подключения к PostgreSQL
# Приложение на хосте + БД в Docker (порт 5432 проброшен наружу):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_hub?schema=public
# Приложение в Docker (сервис app) + БД в той же сети compose:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/knowledge_hub?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_hub?schema=public

# Если DATABASE_URL = prisma+postgres://..., для seed используйте POSTGRES_* или:
# DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_hub?schema=public
# POSTGRES_HOST=db в compose; seed с ноутбука сам подставит 127.0.0.1. Из контейнера: SEED_POSTGRES_HOST=db
